# Variables OPTIONNELLES pour `docker compose up` (racine du dépôt).
# Copier en `.env` et renseigner ce dont on a besoin. Sans ce fichier, la
# pile démarre : connexion e-mail/mot de passe + tout le parcours acheteur/
# vendeur fonctionnent. Ces clés n'activent que des extras.

# ── Connexion Google (bouton « Se connecter avec Google ») ──────────────
# Même Client ID OAuth 2.0 des deux côtés. Sans lui : le bouton ne s'affiche
# pas. Google Cloud Console → APIs & Services → Identifiants.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── AgriScore — agent NDVI Sentinel-2 (Passeport) ──────────────────────
# Sans ces clés : la dimension « couvert végétal » passe en « indisponible »
# et le Passeport se calcule sur les 4 autres. Compte gratuit :
# https://dataspace.copernicus.eu → Sentinel Hub → client OAuth2.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# ── Monitoring Sentry (optionnel) ──────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Firebase — connexion par téléphone (SMS OTP) ───────────────────────
# Config web publique (cf. frontend/.env.example et docs/ONBOARDING_SECRETS.md).
# La connexion e-mail/mot de passe ne dépend PAS de Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Modération IA — palier 2 (branche feat/moderation-ia uniquement) ───
# Désactivé par défaut, sans effet sur `docker compose up` normal. Pour
# tester : `docker compose -f docker-compose.yml -f docker-compose.ia.yml
# up`, puis `... exec ollama ollama pull qwen2.5vl:3b` (~2 Go, à la main),
# puis MODERATION_IA_ACTIVE=1 ci-dessous. cf.
# docs/plans/2026-10-01-moderation-ia-design.md.
MODERATION_IA_ACTIVE=
OLLAMA_URL=
OLLAMA_MODERATION_MODEL=
