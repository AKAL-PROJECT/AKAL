SECRET_KEY=change-me
DATABASE_URL=postgis://user:password@localhost:5432/akal_db
REDIS_URL=redis://127.0.0.1:6379/1

# MinIO (dev) / S3-compatible (prod)
AWS_ACCESS_KEY_ID=akal
AWS_SECRET_ACCESS_KEY=akal12345
AWS_STORAGE_BUCKET_NAME=akal-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
# Vide en dev (URLs directes vers MinIO) ; en prod, domaine public devant le
# bucket/CDN (ex. media.akal.ma) — jamais le domaine de l'API Django.
AWS_S3_CUSTOM_DOMAIN=
# Sans effet tant que l'endpoint est en http:// (dev). Pertinent seulement
# derrière un endpoint S3-compatible auto-signé en https:// local.
AWS_S3_VERIFY=True

# Sentry (monitoring, audit du 2026-08-03) — vide = monitoring désactivé
# (no-op), aucune erreur. Renseigner après création d'un projet sur
# sentry.io (ou une instance self-hosted).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Origine du frontend — utilisée pour construire les liens envoyés par email
# (réinitialisation de mot de passe).
FRONTEND_URL=http://localhost:3000

# Email (réinitialisation de mot de passe, Release Candidate 2026-08-04) —
# EMAIL_HOST vide = backend console (les emails s'affichent dans les logs du
# serveur Django au lieu d'être réellement envoyés). Renseigner ces variables
# pour un vrai envoi SMTP en production.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=AKAL <no-reply@akal.ma>
