# Copier en .env.local et ajuster.

NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_USE_MOCKS=true

# Base absolue utilisée par robots.ts et sitemap.ts (URLs canoniques du
# sitemap, référence dans robots.txt). Sans valeur, retombe sur
# https://akal.ma — à surcharger uniquement si le domaine change.
NEXT_PUBLIC_SITE_URL=https://akal.ma

# Sentry (monitoring, audit du 2026-08-03) — vide = monitoring désactivé
# (no-op), aucune erreur. Renseigner après création d'un projet sur
# sentry.io (ou une instance self-hosted). Même DSN utilisé côté navigateur,
# serveur et edge (cf. instrumentation*.ts) — un DSN Sentry n'est pas un
# secret (il n'autorise qu'à *envoyer* des événements, pas à en lire).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Auth token + org/project : uniquement pour l'upload des source maps au
# build (next.config.ts) — jamais requis pour que le monitoring runtime
# fonctionne. Généré depuis sentry.io → Settings → Auth Tokens.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Firebase (audit d'intégration du 2026-08-15) — authentification par
# téléphone (SMS OTP). Vide = l'init Firebase échoue proprement au premier
# clic sur "Envoyer le code" (message d'erreur affiché à l'utilisateur,
# cf. src/lib/firebase.ts) plutôt que de planter toute la page au chargement.
# Valeurs à récupérer dans la console Firebase du projet AKAL :
# Paramètres du projet → Vos applications → SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google Sign-In (@react-oauth/google) — vide = le bouton "Se connecter avec
# Google" ne s'affiche pas (repli silencieux, cf.
# src/components/GoogleAuthProvider.tsx), reste du site inchangé. Un client
# ID OAuth n'est pas un secret (conçu pour être public côté front) —
# généré dans Google Cloud Console → APIs & Services → Identifiants.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
